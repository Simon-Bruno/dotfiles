{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/simonbruno/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash '/Users/simonbruno/.config/herdr/hooks/name-agent.sh' reset",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash '/Users/simonbruno/.config/herdr/hooks/name-agent.sh' prompt",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash '/Users/simonbruno/.config/herdr/hooks/name-agent.sh' apply",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}