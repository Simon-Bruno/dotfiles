# Karabiner writes these next to its config, and stow links that whole folder here.
karabiner/.config/karabiner/assets/
karabiner/.config/karabiner/automatic_backups/
herdr/.config/herdr/namer/state/
herdr/.config/herdr/namer/namer.log
herdr/.config/herdr/namer/private-panes/
# herdr writes its session and logs next to its config.
herdr/.config/herdr/session.json
herdr/.config/herdr/*.log
herdr/.config/herdr/.plugins.lock
