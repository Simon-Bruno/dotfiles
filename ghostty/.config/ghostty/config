# Native macOS look: Apple's Terminal colors (follow light/dark mode), Liquid Glass
# Dark mode uses a pure-black copy of Apple System Colors (themes/), so the glass reads black, not gray
theme = light:Apple System Colors Light,dark:Apple System Colors Black
window-theme = system
# Slim title bar with the close/minimize/zoom buttons; it takes the window's glass background.
# Ghostty's tab bar only appears if you open Ghostty tabs; herdr has its own.
macos-titlebar-style = transparent
macos-titlebar-proxy-icon = hidden
# No window title text (herdr shows where you are); a space is how Ghostty hides it
title = " "
# Liquid Glass: see-through window with the native macOS 26 glass material
background-opacity = 0.8
# Apple's dim gray (#464646) disappears on glass; use the macOS secondary-label gray instead
palette = 8=#8e8e93
background-blur = macos-glass-regular
# Keep the glass when herdr menus/alerts repaint the background as a solid color
background-opacity-cells = true
window-colorspace = display-p3

font-family = SF Mono
font-size = 12
# Left margin 15pt = exactly two text columns (SF Mono 12pt is 7.5pt wide), so herdr can mirror it before its divider (inset_right = 2).
window-padding-x = 15,16
window-padding-y = 14
window-inherit-font-size = true
adjust-cell-height = 10
copy-on-select = clipboard
right-click-action = paste
macos-option-as-alt = left
keybind = cmd+k=text:\x1b[24;2~
keybind = super+t=text:\x14
initial-command = /Users/simonbruno/.local/bin/herdr
keybind = super+w=text:\x00X

# Ctrl+1..9 switches herdr tabs by sending the prefix plus the digit (herdr's default switch_tab).
keybind = ctrl+1=text:\x001
keybind = ctrl+2=text:\x002
keybind = ctrl+3=text:\x003
keybind = ctrl+4=text:\x004
keybind = ctrl+5=text:\x005
keybind = ctrl+6=text:\x006
keybind = ctrl+7=text:\x007
keybind = ctrl+8=text:\x008
keybind = ctrl+9=text:\x009

# Nightly builds: has the fix for glass going flat when the window is inactive (ghostty PR #13928, due in 1.4.0)
auto-update-channel = tip
